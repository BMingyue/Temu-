# Source repository: default-deny at the root. Runtime, accounts and releases stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/COLLABORATION.md
!/.github/
/.github/*
!/.github/pull_request_template.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/collaboration-checks.yml
!/GIT使用说明.md
!/Git版本管理.cmd
!/从GitHub安装更新.cmd
!/同步店小秘新版.cmd
!/*.py
!/*.ts
!/*.cjs
!/*.mjs
!/*.ps1
!/*.vbs
!/package.json
!/components.json
!/tsconfig.json
!/workbench-release.json
!/workbench-components.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/requirements-rpa.txt
!/app/
!/components/
!/hooks/
!/lib/
!/public/
!/browser_extension/
!/gpt_chrome_extension/
!/image_presets/
!/maintenance/
!/test_fixtures/
/test_fixtures/*
!/test_fixtures/gpt-upload-20261103/
/test_fixtures/gpt-upload-20261103/*
!/test_fixtures/gpt-upload-20261103/menu-button.html
!/test_fixtures/gpt-upload-20261103/plus-button.html
!/local_tools/
/local_tools/*
!/local_tools/qualification/
!/local_tools/compliance-confirmation/
!/local_tools/gpt-extension-folder/
!/local_tools/lion-scraper-extension/
!/local_tools/long-path-mover/
!/release/
/release/*
!/release/*.py
!/release/*.ps1
!/release/*.ts
!/release/*.cmd
!/release/web/

# Nowhere should live data, credentials, browser profiles or dependencies be tracked.
**/data/
**/state/
**/logs/
**/failure-records*/
**/browser-profile/
**/user-data/
**/runtime/
**/node_modules/
**/__pycache__/
**/.git/
**/.migration/
**/.openai/
**/.env*
/maintenance/local-collaboration.json
**/*.pyc
**/*.pyo
**/*.log
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*.exe
**/*.dll
**/*.zip
**/*.xpi
**/*.crx
**/*.tsbuildinfo
/local_tools/qualification/assets/
/release/firefox-gpt-local-channel-status.json
